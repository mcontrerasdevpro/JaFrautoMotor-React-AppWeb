BASENAME=/

# Frontend (Vite): URL de la API. En local, por defecto http://127.0.0.1:3001
# VITE_API_URL=https://tu-api.onrender.com

# Backend (Flask) - conexión a Neon (ver Connection Details en el dashboard de Neon)
# Para desarrollo usa una rama de Neon o un Postgres local, nunca la base de producción.
DATABASE_URL="postgresql://usuario:password@host.neon.tech/basededatos?sslmode=require"
DATABASE_URL_POOLED="postgresql://usuario:password@host-pooler.neon.tech/basededatos?sslmode=require"

# Secreto para firmar los tokens JWT de clientes (genera uno propio, no reutilices este)
JWT_SECRET_KEY=cambia_esto_por_un_valor_aleatorio_largo
# Horas que dura la sesión antes de pedir login otra vez (por defecto 12)
JWT_EXPIRES_HOURS=12

# Dominios que pueden llamar a la API desde el navegador, separados por comas.
# Admite expresiones regulares (p. ej. para previews de Vercel).
# Si no se define, se usan la demo de Vercel, jafrautomotor.com y localhost:3000.
CORS_ORIGINS=https://ja-frauto-motor-react-app-web.vercel.app,https://jafrautomotor.com,https://www.jafrautomotor.com,http://localhost:3000

# Número de proxies delante de la API (Render = 1; en local sin proxy = 0)
TRUSTED_PROXIES=1
# Almacén de los contadores del rate limit. memory:// vale con un solo proceso;
# con varios workers o instancias, usa Redis (redis://host:6379).
RATELIMIT_STORAGE_URI=memory://

# Envío de emails (Gmail SMTP)
# MAIL_USERNAME es la cuenta de Gmail que envía los correos.
# MAIL_PASSWORD es una "contraseña de aplicación" de Gmail, NO tu contraseña normal:
# https://myaccount.google.com/apppasswords (requiere verificación en 2 pasos activada)
MAIL_USERNAME=tucuenta@gmail.com
MAIL_PASSWORD=contraseña_de_aplicacion_de_16_caracteres
# Dónde recibe el taller los avisos de presupuestos, contactos y citas nuevas
# (si no se define, se usa MAIL_USERNAME)
TALLER_NOTIFY_EMAIL=jafrautomotor@gmail.com
# Proveedor de email: smtp (Gmail, por defecto) o resend. Resend necesita el dominio
# verificado con registros DNS, así que se activa al migrar a jafrautomotor.com.
EMAIL_PROVIDER=smtp
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=JaFrauto Motor <citas@jafrautomotor.com>

# Teléfono del taller que aparece en emails y avisos
TALLER_TELEFONO=953 121 814
# URL pública de la web (para los enlaces de "cambiar o cancelar cita")
FRONTEND_URL=https://ja-frauto-motor-react-app-web.vercel.app

# Agenda: coches por franja si aún no se ha guardado desde el panel
CAPACIDAD_FRANJA=3

# Asistente de reservas con IA (opcional). Sin clave funciona solo con reglas.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Máximo de consultas a la IA por día (protege el gasto)
ASISTENTE_IA_MAX_DIA=200

# n8n: webhooks de cita (creada, cambiada, cancelada, confirmada, completada).
# Cada envío va firmado con HMAC-SHA256 en la cabecera X-JaFrauto-Signature.
# N8N_WEBHOOK_URL=https://tu-n8n/webhook/jafrauto-citas
# N8N_WEBHOOK_SECRET=genera_un_secreto_largo_y_aleatorio
# Token que comprueba el nodo Webhook de n8n (credencial Header Auth, cabecera X-JaFrauto-Token)
# N8N_WEBHOOK_TOKEN=genera_otro_token_largo_y_aleatorio
# Clave con la que n8n llama a /internal/reminders (cabecera X-API-Key)
# N8N_API_KEY=genera_otra_clave_larga_y_aleatoria
