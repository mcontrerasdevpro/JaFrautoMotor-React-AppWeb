{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/login", "destination": "/app-shell.html" },
        { "source": "/registro", "destination": "/app-shell.html" },
        { "source": "/gestion", "destination": "/app-shell.html" },
        { "source": "/reservar", "destination": "/app-shell.html" },
        { "source": "/urgente", "destination": "/app-shell.html" },
        { "source": "/mi-cuenta", "destination": "/app-shell.html" },
        { "source": "/panel-interno", "destination": "/app-shell.html" },
        { "source": "/cita/:token", "destination": "/app-shell.html" }
    ],
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
        },
        {
            "source": "/img/(.*)",
            "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
        }
    ]
}
